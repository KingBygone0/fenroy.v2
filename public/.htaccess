<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — force HTTPS for 1 year, include subdomains
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Prevent clickjacking (belt-and-suspenders with CSP frame-ancestors below)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Stop MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy — send origin only to third parties, full URL within same site
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — restrict browser APIs this site does not use
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()"

    # Prevent Adobe Flash/PDF cross-domain data loading
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # Content Security Policy
    # Notes:
    #   - 'unsafe-inline' on script-src is required by Livewire 4 and Alpine.js
    #     (both rely on inline event handlers; nonce-based CSP would need framework changes)
    #   - 'unsafe-inline' on style-src is required by Livewire/Filament dynamic styles
    #   - frame-ancestors restricts who can embed this site in an iframe
    #   - form-action prevents form POST hijacking to external URLs
    #   - base-uri blocks <base href="..."> injection attacks
    #   - object-src none blocks Flash/PDF plugin execution
    #   - upgrade-insecure-requests forces mixed-content resources over HTTPS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.paystack.co https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://paystack.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://api.paystack.co https://eu.i.posthog.com https://eu-assets.i.posthog.com; frame-src 'self' https://js.paystack.co https://checkout.paystack.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"

    # Disable CORS — no cross-origin API consumers for this storefront
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
</IfModule>

# ── Limit Request Size (2MB max) ─────────────────────────────────────────────
<IfModule mod_php.c>
    php_value post_max_size 2M
    php_value upload_max_filesize 2M
</IfModule>

LimitRequestBody 2097152

# ── Block sensitive files from public access ─────────────────────────────────
<FilesMatch "(\.env|\.git|composer\.(json|lock)|package\.json|webpack\.mix\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Prevent PHP execution in uploaded file storage ───────────────────────────
# Any file under /storage/ that has a server-side script extension is forbidden.
# This is defence-in-depth: the application should never store files with these
# extensions, but if an attacker bypasses upload validation this rule ensures
# the files cannot be executed via HTTP.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteRule \.ph(p[3-9]?|ps|t|tml|ar)$ - [F,L,NC]
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteRule \.(shtml|phtml|pl|py|sh|rb|cgi|asp|aspx|jsp)$ - [F,L,NC]
</IfModule>
